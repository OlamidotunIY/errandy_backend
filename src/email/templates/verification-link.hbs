<html>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{{subject}}}</title>
    <style>
      /* Base Resets */
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
        background-color: #ffffff;
        color: #111827;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;
        line-height: 1.5;
      }

      /* Container */
      .wrapper {
        width: 100%;
        background-color: #ffffff;
        padding: 60px 0;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 0 20px;
        text-align: center;
      }

      /* Typography */
      h1 {
        margin: 0 0 16px 0;
        font-size: 24px;
        font-weight: 800;
        color: #111827;
      }
      p {
        margin: 0 0 24px 0;
        font-size: 16px;
        color: #4b5563;
      }

      /* Elements */
      .logo {
        width: 120px;
        height: auto;
        margin: 0 auto 40px auto;
        display: block;
      }
      .icon {
        font-size: 48px;
        margin-bottom: 24px;
        display: block;
      }

      .button {
        display: inline-block;
        background-color: #111827;
        color: #ffffff;
        padding: 16px 40px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        margin: 32px 0;
        transition: background-color 0.2s;
      }
      .button:hover {
        background-color: #000000;
      }

      .link-text {
        color: #4f46e5;
        word-break: break-all;
        font-size: 14px;
        text-decoration: none;
      }

      /* Footer */
      .footer {
        margin-top: 60px;
        padding-top: 32px;
        border-top: 1px solid #f3f4f6;
      }
      .footer p {
        font-size: 13px;
        color: #9ca3af;
        margin-bottom: 8px;
      }
      .footer a {
        color: #6b7280;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='container'>
        <img
          src='https://firebasestorage.googleapis.com/v0/b/errandy-480815.firebasestorage.app/o/logo.png?alt=media&token=e1ffc278-42e2-43e1-a79d-84f2345bf620'
          alt='Errandy'
          class='logo'
        />

        <span class='icon'>✉️</span>
        <h1>Verify your email</h1>

        <p>Hi {{{name}}}, thank you for joining Errandy.</p>
        <p>Please confirm your email address to activate your account.</p>

        <a href='{{{url}}}' class='button'>Verify Email</a>

        <p style='font-size: 14px; color: #9CA3AF;'>Or paste this link into your
          browser:</p>
        <p><a href='{{{url}}}' class='link-text'>{{{url}}}</a></p>

        <div class='footer'>
          <p>&copy; {{{year}}} Errandy. All rights reserved.</p>
          <p>
            <a href='{{{unsubscribeUrl}}}'>Unsubscribe</a>
            &bull;
            <a href='https://errandy.app/privacy'>Privacy Policy</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>