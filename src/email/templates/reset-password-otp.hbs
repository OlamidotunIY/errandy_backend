<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>{{{subject}}}</title>

    <!--[if mso]>
      <style type="text/css">
        body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
      </style>
    <![endif]-->

    <style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      /* Resets */
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        height: 100% !important;
        width: 100% !important;
      }
      * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; }
      table { border-collapse: collapse !important; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; height: auto; line-height: 100%; }
      a { text-decoration: none; }

      /* Brand tokens (light) */
      .bg { background: #f9fafb; }
      .container { width: 100%; max-width: 640px; margin: 0 auto; }
      .card {
        background: #ffffff;
        border: 1px solid #f1f1f4;
        border-radius: 16px;
        overflow: hidden;
      }
      .divider { height: 1px; background: #f1f1f4; }

      /* Typography */
      .kicker {
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 800;
        color: #1b84ff;
        margin: 0;
      }
      .h1 {
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.01em;
        font-weight: 900;
        color: #071437;
        margin: 0;
      }
      .p {
        font-size: 15px;
        line-height: 1.65;
        color: #4b5675;
        margin: 0;
      }
      .muted {
        font-size: 12px;
        line-height: 1.6;
        color: #99a1b7;
        margin: 0;
      }

      /* OTP box */
      .otp-wrap {
        background: #fff7ed;            /* warm surface to indicate "reset" */
        border: 1px solid #ffedd5;
        border-radius: 14px;
      }
      .otp {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 34px;
        letter-spacing: 10px;
        font-weight: 900;
        color: #071437;
        text-align: center;
      }
      .chip {
        display: inline-block;
        font-size: 12px;
        font-weight: 800;
        color: #071437;
        background: #ffffff;
        border: 1px solid #f1f1f4;
        border-radius: 999px;
        padding: 8px 10px;
      }

      /* Mobile */
      @media screen and (max-width: 640px) {
        .px { padding-left: 18px !important; padding-right: 18px !important; }
        .pt { padding-top: 18px !important; }
        .pb { padding-bottom: 18px !important; }
        .h1 { font-size: 22px !important; }
        .otp { font-size: 30px !important; letter-spacing: 8px !important; }
      }
    </style>
  </head>

  <body class="bg" style="background:#f9fafb; margin:0; padding:0;">
    <!-- Preheader (hidden) -->
    <div
      style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;"
    >
      Reset your Errandy password with code {{{otp}}}. Valid for 10 minutes.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg">
      <tr>
        <td align="center" style="padding: 28px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="container">

            <!-- Brand row -->
            <tr>
              <td align="left" class="px" style="padding: 0 26px 14px 26px;">
                <img
                  src="https://firebasestorage.googleapis.com/v0/b/errandy-480815.firebasestorage.app/o/logo.png?alt=media&token=e1ffc278-42e2-43e1-a79d-84f2345bf620"
                  width="132"
                  alt="Errandy"
                  style="width:132px; max-width:132px;"
                />
              </td>
            </tr>

            <!-- Card -->
            <tr>
              <td class="px" style="padding: 0 26px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card">

                  <!-- Accent strip -->
                  <tr>
                    <td style="background:#1b84ff;">
                      <div style="height: 6px; line-height:6px; font-size:6px;">&nbsp;</div>
                    </td>
                  </tr>

                  <!-- Header -->
                  <tr>
                    <td class="px pt" style="padding: 22px 28px 8px 28px;">
                      <p class="kicker">Password reset</p>
                      <div style="height:10px;"></div>

                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td valign="middle" style="width:44px;">
                            <table
                              role="presentation"
                              cellpadding="0"
                              cellspacing="0"
                              border="0"
                              style="background:#eff6ff; border:1px solid #dbeafe; border-radius:12px;"
                            >
                              <tr>
                                <td
                                  align="center"
                                  valign="middle"
                                  style="width:44px; height:44px; font-size:20px; line-height:44px;"
                                >
                                  🔑
                                </td>
                              </tr>
                            </table>
                          </td>
                          <td valign="middle" style="padding-left:12px;">
                            <h1 class="h1">Reset your password</h1>
                            <div style="height:4px;"></div>
                            <p class="p" style="font-size:14px;">
                              Use the code below to reset your Errandy password.
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- OTP -->
                  <tr>
                    <td class="px" style="padding: 14px 28px 8px 28px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="otp-wrap">
                        <tr>
                          <td style="padding: 18px;">
                            <!--[if mso]>
                              <div style="text-align:center; font-family: Consolas, 'Courier New', monospace; font-size: 34px; font-weight: 900; letter-spacing: 10px; color: #071437;">
                                {{{otp}}}
                              </div>
                            <![endif]-->
                            <!--[if !mso]><!-- -->
                            <div class="otp">{{{otp}}}</div>
                            <!--<![endif]-->

                            <div style="height:12px;"></div>
                            <div style="text-align:center;">
                              <span class="chip">Valid for 10 minutes</span>
                            </div>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Security note -->
                  <tr>
                    <td class="px pb" style="padding: 10px 28px 22px 28px;">
                      <p class="p" style="font-size:13px; color:#4b5675;">
                        If you didn’t request a password reset, you can ignore this email.
                        For your security, don’t share this code with anyone.
                      </p>
                    </td>
                  </tr>

                  <tr><td><div class="divider"></div></td></tr>

                  <!-- Footer links -->
                  <tr>
                    <td class="px" style="padding: 16px 28px;">
                      <p class="muted">
                        &copy; {{{year}}} Errandy. All rights reserved.
                      </p>
                      <div style="height:8px;"></div>
                      <p class="muted">
                        <a href="{{{unsubscribeUrl}}}" style="color:#4b5675; text-decoration:underline;">Unsubscribe</a>
                        &nbsp;&bull;&nbsp;
                        <a href="https://errandy.com.ng/privacy" style="color:#4b5675; text-decoration:underline;">Privacy Policy</a>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr><td style="padding: 14px 0;"></td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>