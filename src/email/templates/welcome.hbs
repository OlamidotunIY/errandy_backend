<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Welcome to Errandy</title>
    <!--[if mso]>
      <style type="text/css">
        body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
      </style>
    <![endif]-->
    <style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      /* Reset / base */
      html,
      body {
        margin: 0 !important;
        padding: 0 !important;
        height: 100% !important;
        width: 100% !important;
      }
      * {
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt !important;
        mso-table-rspace: 0pt !important;
      }
      table {
        border-collapse: collapse !important;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        outline: none;
        text-decoration: none;
        display: block;
        height: auto;
        line-height: 100%;
      }
      a {
        text-decoration: none;
      }

      /* Layout helpers */
      .bg {
        background: #f6f7fb;
      }
      .container {
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
      }
      .card {
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Typography */
      .h1 {
        font-size: 34px;
        line-height: 1.15;
        letter-spacing: -0.02em;
        font-weight: 800;
        color: #0b1220;
        margin: 0;
      }
      .subhead {
        font-size: 16px;
        line-height: 1.6;
        color: #465066;
        margin: 0;
      }
      .muted {
        font-size: 13px;
        line-height: 1.6;
        color: #8b93a7;
        margin: 0;
      }
      .small {
        font-size: 12px;
        line-height: 1.6;
        color: #8b93a7;
        margin: 0;
      }

      /* Button (bulletproof-ish) */
      .btn {
        background: #0b1220;
        border-radius: 12px;
        display: inline-block;
        font-size: 16px;
        font-weight: 700;
        line-height: 1;
        padding: 16px 22px;
        color: #ffffff !important;
      }

      /* Feature blocks */
      .feature-title {
        font-size: 15px;
        font-weight: 800;
        line-height: 1.25;
        color: #0b1220;
        margin: 0;
      }
      .feature-desc {
        font-size: 14px;
        line-height: 1.55;
        color: #55607a;
        margin: 0;
      }
      .icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f1f3f8;
        text-align: center;
        vertical-align: middle;
      }
      .icon {
        font-size: 20px;
        line-height: 44px;
      }

      /* Dividers */
      .divider {
        height: 1px;
        background: #eef0f5;
      }

      /* Mobile */
      @media screen and (max-width: 640px) {
        .px {
          padding-left: 18px !important;
          padding-right: 18px !important;
        }
        .pt {
          padding-top: 18px !important;
        }
        .pb {
          padding-bottom: 18px !important;
        }
        .h1 {
          font-size: 28px !important;
        }
        .stack {
          display: block !important;
          width: 100% !important;
        }
        .stack-pad {
          padding: 0 !important;
        }
        .gap-top {
          padding-top: 14px !important;
        }
      }
    </style>
  </head>

  <body class="bg" style="background:#f6f7fb; margin:0; padding:0;">
    <!-- Preheader (hidden) -->
    <div
      style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;"
    >
      Welcome to Errandy — post errands, hire trusted pros, and reclaim your time.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg">
      <tr>
        <td align="center" style="padding: 28px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="container">
            <!-- Top spacing -->
            <tr>
              <td style="padding: 6px 0;"></td>
            </tr>

            <!-- Brand row -->
            <tr>
              <td align="left" class="px" style="padding: 0 26px 14px 26px;">
                <img
                  src="https://firebasestorage.googleapis.com/v0/b/errandy-480815.firebasestorage.app/o/logo.png?alt=media&token=e1ffc278-42e2-43e1-a79d-84f2345bf620"
                  width="132"
                  alt="Errandy"
                  style="width:132px; max-width:132px;"
                />
              </td>
            </tr>

            <!-- Card -->
            <tr>
              <td class="px" style="padding: 0 26px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="card">
                  <!-- Hero -->
                  <tr>
                    <td class="px pt" style="padding: 28px 28px 10px 28px;">
                      <h1 class="h1">Welcome to Errandy, {{{name}}}.</h1>
                    </td>
                  </tr>
                  <tr>
                    <td class="px" style="padding: 0 28px 18px 28px;">
                      <p class="subhead">
                        Errandy helps you get things done faster — post errands, connect with trusted providers,
                        and reclaim your time in Lagos and beyond.
                      </p>
                    </td>
                  </tr>

                  <!-- CTA -->
                  <tr>
                    <td class="px pb" style="padding: 0 28px 26px 28px;">
                      <!--[if mso]>
                        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word"
                          href="https://errandy.app" style="height:52px;v-text-anchor:middle;width:200px;" arcsize="20%"
                          strokecolor="#0b1220" fillcolor="#0b1220">
                          <w:anchorlock/>
                          <center style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;">
                            Get started
                          </center>
                        </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a href="https://errandy.app" class="btn">Get started</a>
                      <!--<![endif]-->
                      <div style="height:10px; line-height:10px; font-size:10px;">&nbsp;</div>
                      <p class="muted">
                        Tip: Save Errandy to your home screen for quicker access.
                      </p>
                    </td>
                  </tr>

                  <!-- Divider -->
                  <tr>
                    <td>
                      <div class="divider"></div>
                    </td>
                  </tr>

                  <!-- Features header -->
                  <tr>
                    <td class="px" style="padding: 22px 28px 10px 28px;">
                      <p style="margin:0; font-size:14px; font-weight:800; color:#0b1220; letter-spacing:0.2px;">
                        What you can do next
                      </p>
                    </td>
                  </tr>

                  <!-- Features grid -->
                  <tr>
                    <td class="px pb" style="padding: 0 28px 26px 28px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <!-- Feature 1 -->
                          <td class="stack" width="50%" valign="top" style="padding: 12px 10px 12px 0;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                              <tr>
                                <td class="icon-wrap" align="center" valign="middle">
                                  <span class="icon">🚀</span>
                                </td>
                                <td style="padding-left: 12px;">
                                  <p class="feature-title">Post errands</p>
                                  <div style="height:6px;"></div>
                                  <p class="feature-desc">
                                    Describe what you need, set your budget, and get responses from providers.
                                  </p>
                                </td>
                              </tr>
                            </table>
                          </td>

                          <!-- Feature 2 -->
                          <td class="stack" width="50%" valign="top" style="padding: 12px 0 12px 10px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                              <tr>
                                <td class="icon-wrap" align="center" valign="middle">
                                  <span class="icon">🛡️</span>
                                </td>
                                <td style="padding-left: 12px;">
                                  <p class="feature-title">Trusted pros</p>
                                  <div style="height:6px;"></div>
                                  <p class="feature-desc">
                                    Connect with vetted providers you can rely on for quality service.
                                  </p>
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>

                        <tr>
                          <!-- Feature 3 -->
                          <td class="stack" width="50%" valign="top" style="padding: 12px 10px 12px 0;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                              <tr>
                                <td class="icon-wrap" align="center" valign="middle">
                                  <span class="icon">💳</span>
                                </td>
                                <td style="padding-left: 12px;">
                                  <p class="feature-title">Secure payments</p>
                                  <div style="height:6px;"></div>
                                  <p class="feature-desc">
                                    Your funds are protected and released only when you’re satisfied.
                                  </p>
                                </td>
                              </tr>
                            </table>
                          </td>

                          <!-- Feature 4 -->
                          <td class="stack" width="50%" valign="top" style="padding: 12px 0 12px 10px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                              <tr>
                                <td class="icon-wrap" align="center" valign="middle">
                                  <span class="icon">✨</span>
                                </td>
                                <td style="padding-left: 12px;">
                                  <p class="feature-title">Relax</p>
                                  <div style="height:6px;"></div>
                                  <p class="feature-desc">
                                    Focus on what matters while we handle your to-do list end-to-end.
                                  </p>
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                  <!-- Secondary CTA strip -->
                  <tr>
                    <td style="background:#f7f8fc;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td class="px" style="padding: 18px 28px;">
                            <p style="margin:0; font-size:14px; color:#465066;">
                              Ready to try your first errand?
                              <a href="https://errandy.app" style="color:#0b1220; font-weight:800; text-decoration:underline;">
                                Post one now
                              </a>
                              .
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" class="px" style="padding: 18px 26px 0 26px;">
                <p class="small" style="margin-bottom: 8px;">
                  &copy; {{{year}}} Errandy • Lagos, Nigeria
                </p>
                <p class="small" style="margin-bottom: 0;">
                  <a href="{{{unsubscribeUrl}}}" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a>
                  &nbsp;&bull;&nbsp;
                  <a href="https://errandy.app/privacy" style="color:#6b7280; text-decoration:underline;">Privacy Policy</a>
                </p>
              </td>
            </tr>

            <!-- Bottom spacing -->
            <tr>
              <td style="padding: 14px 0;"></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>