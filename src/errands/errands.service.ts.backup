import { PaginatedErrands } from './entities/paginated-errands.entity';
import { GqlServiceCategoryType } from 'src/service/entities/enums';

// PubSub interface
interface PubSub {
  publish(event: string, data: any): Promise<void>;
  asyncIterator(events: string | string[]): any;
}

export interface GeoPoint {
  type: 'Point';
  coordinates: [number, number]; // [lng, lat]
}

// MongoDB aggregation result types - these come from MongoDB as JSON
interface ErrandWithGeoData {
  id: string;
  userId: string;
  title: string;
  description: string | null;
  pricingType: string;
  price: number | null;
  hourlyRate: number | null;
  status: string;
  service: string | null;
  profession: string | null;
  workerType: string | null;
  serviceAddress: string | null;
  location: object | null;
  urgency: string | null;
  timeConstraints: string | null;
  createdAt: Date;
  updatedAt: Date;
  distance: number;
  priority?: number;
  matchScore?: number;
}

interface CountResult {
  total: number;
}

@Injectable()
export class ErrandsService {
  constructor(
    private readonly prisma: PrismaService,
    @Inject('PUB_SUB') private readonly pubSub: PubSub,
  ) {}

  async create(createErrandInput: CreateErrandInput, userId: string) {
    const errand = await this.prisma.errand.create({
      data: {
        ...createErrandInput,
        userId,
      },
      include: {
        reviews: true,
      },
    });

    // Publish errand created event for real-time updates
    await this.pubSub.publish('errandCreated', {
      errandCreated: {
        errand,
        type: 'CREATED',
        userId,
      },
    });

    return errand;
  }

  async findAll(dto: GetAllErrandInput, userId: string) {
    const meters = (dto.maxDistanceKm ?? 5) * 1000; // default to 5km

    // Get user's active address + workerType + skills
    const user = await this.prisma.user.findFirst({
      where: { id: userId },
      include: {
        activeAddress: true,
        worker: {
          include: {
            services: true,
          },
        },
      },
    });

    if (!user?.activeAddress?.location) {
      throw new Error('No active address set for user');
    }

    const location = user.activeAddress.location as unknown as GeoPoint;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    // Create conditions for matching jobs
    let priorityMatch: Record<string, any> = {};
    if (user?.worker?.services?.length) {
      priorityMatch.service = { $in: user.worker.services };
    }

    return this.prisma.errand.aggregateRaw({
      pipeline: [
        {
          $geoNear: {
            near: { type: 'Point', coordinates: [userLng, userLat] },
            distanceField: 'distance',
            maxDistance: meters,
            spherical: true,
          },
        },
        {
          $match: {
            status: 'OPEN',
            workerType: user.worker?.workerType,
          },
        },
        {
          $addFields: {
            priority: {
              $cond: [
                {
                  $or: priorityMatch.service
                    ? [{ $in: ['$service', user.worker?.services] }]
                    : [],
                },
                1,
                0,
              ],
            },
          } as Prisma.InputJsonValue,
        },
        {
          $sort: {
            priority: -1, // Matches first
            distance: 1, // Then closest
          },
        },
      ],
    });
  }

  findOne(id: string) {
    return this.prisma.errand.findUnique({
      where: {
        id,
      },
    });
  }

  async update(updateErrandInput: UpdateErrandInput) {
    const errand = await this.prisma.errand.update({
      where: {
        id: updateErrandInput.id,
      },
      data: updateErrandInput,
      include: {
        reviews: true,
      },
    });

    // Publish errand updated event for real-time updates
    await this.pubSub.publish('errandUpdated', {
      errandUpdated: {
        errand,
        type: 'UPDATED',
        userId: errand.userId,
      },
    });

    return errand;
  }

  updateLocation(UpdateErrandLocation: UpdateErrandLocation) {
    const geoLocation: Prisma.InputJsonValue = {
      type: 'Point',
      coordinates: [
        Number(UpdateErrandLocation.longitude),
        Number(UpdateErrandLocation.latitude),
      ],
    };

    return this.prisma.errand.update({
      where: {
        id: UpdateErrandLocation.id,
      },
      data: {
        serviceAddress: UpdateErrandLocation.serviceAddress,
        location: geoLocation,
      },
    });
  }

  async remove(id: string) {
    const errand = await this.prisma.errand.findUnique({
      where: { id },
      include: { reviews: true },
    });

    if (!errand) {
      throw new Error('Errand not found');
    }

    await this.prisma.errand.delete({
      where: { id },
    });

    // Publish errand deleted event for real-time updates
    await this.pubSub.publish('errandDeleted', {
      errandDeleted: {
        errand,
        type: 'DELETED',
        userId: errand.userId,
      },
    });

    return errand;
  }

  /**
   * Advanced get errands with personalized feeds and location-based filtering
   */
  async getErrands(queryInput: ErrandQueryInput, userId: string): Promise<PaginatedErrands> {
    const { type, search, pagination, maxDistanceKm = 20 } = queryInput;
    const { page = 1, limit = 20 } = pagination || {};

    const skip = (page - 1) * limit;

    switch (type) {
      case 'feed':
        return this.getFeedErrands(userId, skip, limit, maxDistanceKm);
      case 'best_match':
        return this.getBestMatchErrands(userId, skip, limit, maxDistanceKm);
      case 'most_recent':
        return this.getRecentErrands(userId, skip, limit, maxDistanceKm);
      case 'saved':
        return this.getSavedErrands(userId, skip, limit);
      case 'search':
        return this.searchErrands(userId, search || '', skip, limit, maxDistanceKm);
      default:
        return this.getFeedErrands(userId, skip, limit, maxDistanceKm);
    }
  }

  /**
   * Get user's active address for location-based filtering
   */
  private async getUserActiveAddress(userId: string) {
    const user = await this.prisma.user.findFirst({
      where: { id: userId },
      include: {
        activeAddress: true,
        worker: {
          include: {
            services: true,
          },
        },
      },
    });

    if (!user?.activeAddress?.location) {
      throw new Error('No active address set for user');
    }

    return {
      user,
      location: user.activeAddress.location as unknown as GeoPoint,
    };
  }

  /**
   * Feed: Personalized errands based on location and user preferences
   */
  async getFeedErrands(userId: string, skip: number, limit: number, maxDistanceKm: number): Promise<PaginatedErrands> {
    const { user, location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    // Build priority matching criteria
    let priorityMatch: Record<string, any> = {};
    if (user?.worker?.services?.length) {
      priorityMatch.service = { $in: user.worker.services };
    }

    const pipeline = [
      {
        $geoNear: {
          near: { type: 'Point', coordinates: [userLng, userLat] },
          distanceField: 'distance',
          maxDistance: meters,
          spherical: true,
        },
      },
      {
        $match: {
          status: 'OPEN',
          userId: { $ne: userId }, // Exclude user's own errands
        },
      },
      {
        $addFields: {
          priority: {
            $cond: [
              {
                $or: priorityMatch.service
                  ? [{ $in: ['$service', user.worker?.services] }]
                  : [],
              },
              1,
              0,
            ],
          } as Prisma.InputJsonValue,
        },
      },
      {
        $sort: {
          priority: -1, // Matches first
          distance: 1, // Then closest
          createdAt: -1, // Then newest
        },
      },
      { $skip: skip },
      { $limit: limit },
    ];

    const errands = await this.prisma.errand.aggregateRaw({ pipeline }) as unknown as any[];
    const total = await this.getErrandsCount(userId, maxDistanceKm);
    const page = Math.floor(skip / limit) + 1;

    return this.buildPaginatedResponse(errands, total, page, limit);
  }

  /**
   * Best Match: Errands matching user's skills and preferences
   */
  async getBestMatchErrands(userId: string, skip: number, limit: number, maxDistanceKm: number): Promise<PaginatedErrands> {
    const { user, location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const pipeline = [
      {
        $geoNear: {
          near: { type: 'Point', coordinates: [userLng, userLat] },
          distanceField: 'distance',
          maxDistance: meters,
          spherical: true,
        },
      },
      {
        $match: {
          status: 'OPEN',
          userId: { $ne: userId },
          $or: [
            { service: { $in: user.worker?.services || [] } },
            { profession: user.worker?.workerType },
          ],
        },
      },
      {
        $addFields: {
          matchScore: {
            $add: [
              {
                $cond: [
                  { $in: ['$service', user.worker?.services || []] },
                  2,
                  0,
                ],
              },
              {
                $cond: [
                  { $eq: ['$profession', user.worker?.workerType] },
                  1,
                  0,
                ],
              },
            ],
          } as Prisma.InputJsonValue,
        },
      },
      {
        $sort: {
          matchScore: -1,
          distance: 1,
          createdAt: -1,
        },
      },
      { $skip: skip },
      { $limit: limit },
    ];

    const aggregationResult = await this.prisma.errand.aggregateRaw({ pipeline });
    // MongoDB aggregateRaw returns JsonObject, convert to our typed array
    const errands = (aggregationResult as ErrandWithGeoData[]);
    const total = await this.getMatchingErrandsCount(userId, maxDistanceKm);
    const page = Math.floor(skip / limit) + 1;

    return this.buildPaginatedResponse(errands, total, page, limit);
  }

  /**
   * Most Recent: Latest errands near user
   */
  async getRecentErrands(userId: string, skip: number, limit: number, maxDistanceKm: number): Promise<PaginatedErrands> {
    const { location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const pipeline = [
      {
        $geoNear: {
          near: { type: 'Point', coordinates: [userLng, userLat] },
          distanceField: 'distance',
          maxDistance: meters,
          spherical: true,
        },
      },
      {
        $match: {
          status: 'OPEN',
          userId: { $ne: userId },
        },
      },
      {
        $sort: {
          createdAt: -1,
          distance: 1,
        },
      },
      { $skip: skip },
      { $limit: limit },
    ];

    const errands = await this.prisma.errand.aggregateRaw({ pipeline }) as unknown as any[];
    const total = await this.getErrandsCount(userId, maxDistanceKm);
    const page = Math.floor(skip / limit) + 1;

    return this.buildPaginatedResponse(errands, total, page, limit);
  }

  /**
   * Saved: User's bookmarked errands
   */
  async getSavedErrands(userId: string, skip: number, limit: number): Promise<PaginatedErrands> {
    // Assuming we have a SavedErrand table - adjust based on your schema
    const errands = await this.prisma.errand.findMany({
      where: {
        // This would be adjusted based on your saved errands schema
        // For now, using a mock condition
        id: { in: [] }, // Replace with actual saved errands logic
      },
      include: {
        reviews: true,
      },
      orderBy: {
        createdAt: 'desc',
      },
      skip,
      take: limit,
    });

    const total = 0; // Replace with actual saved errands count
    const page = Math.floor(skip / limit) + 1;

    return this.buildPaginatedResponse(errands, total, page, limit);
  }

  /**
   * Search: Text search with location filtering
   */
  async searchErrands(userId: string, keyword: string, skip: number, limit: number, maxDistanceKm: number): Promise<PaginatedErrands> {
    const { location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const pipeline = [
      {
        $geoNear: {
          near: { type: 'Point', coordinates: [userLng, userLat] },
          distanceField: 'distance',
          maxDistance: meters,
          spherical: true,
        },
      },
      {
        $match: {
          status: 'OPEN',
          userId: { $ne: userId },
          $or: [
            { title: { $regex: keyword, $options: 'i' } },
            { description: { $regex: keyword, $options: 'i' } },
            { service: { $regex: keyword, $options: 'i' } },
            { profession: { $regex: keyword, $options: 'i' } },
          ],
        },
      },
      {
        $sort: {
          distance: 1,
          createdAt: -1,
        },
      },
      { $skip: skip },
      { $limit: limit },
    ];

    const aggregationResult = await this.prisma.errand.aggregateRaw({ pipeline });
    // MongoDB aggregateRaw returns JsonObject, convert to our typed array
    const errands = (aggregationResult as ErrandWithGeoData[]);
    const total = await this.getSearchErrandsCount(userId, keyword, maxDistanceKm);
    const page = Math.floor(skip / limit) + 1;

    return this.buildPaginatedResponse(errands, total, page, limit);
  }

  /**
   * Helper methods for counting
   */
  private async getErrandsCount(userId: string, maxDistanceKm: number): Promise<number> {
    const { location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const aggregationResult = await this.prisma.errand.aggregateRaw({
      pipeline: [
        {
          $geoNear: {
            near: { type: 'Point', coordinates: [userLng, userLat] },
            distanceField: 'distance',
            maxDistance: meters,
            spherical: true,
          },
        },
        {
          $match: {
            status: 'OPEN',
            userId: { $ne: userId },
          },
        },
        { $count: 'total' },
      ],
    });

    const countResult = Array.isArray(aggregationResult) ? 
      aggregationResult as CountAggregationResult[] : 
      [aggregationResult] as CountAggregationResult[];
    return countResult[0]?.total || 0;
  }

  private async getMatchingErrandsCount(userId: string, maxDistanceKm: number): Promise<number> {
    const { user, location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const aggregationResult = await this.prisma.errand.aggregateRaw({
      pipeline: [
        {
          $geoNear: {
            near: { type: 'Point', coordinates: [userLng, userLat] },
            distanceField: 'distance',
            maxDistance: meters,
            spherical: true,
          },
        },
        {
          $match: {
            status: 'OPEN',
            userId: { $ne: userId },
            $or: [
              { service: { $in: user.worker?.services || [] } },
              { profession: user.worker?.workerType },
            ],
          },
        },
        { $count: 'total' },
      ],
    });

    const countResult = Array.isArray(aggregationResult) ? 
      aggregationResult as CountAggregationResult[] : 
      [aggregationResult] as CountAggregationResult[];
    return countResult[0]?.total || 0;
  }

  private async getSearchErrandsCount(userId: string, keyword: string, maxDistanceKm: number): Promise<number> {
    const { location } = await this.getUserActiveAddress(userId);
    const meters = maxDistanceKm * 1000;
    const userLat = location.coordinates[1];
    const userLng = location.coordinates[0];

    const aggregationResult = await this.prisma.errand.aggregateRaw({
      pipeline: [
        {
          $geoNear: {
            near: { type: 'Point', coordinates: [userLng, userLat] },
            distanceField: 'distance',
            maxDistance: meters,
            spherical: true,
          },
        },
        {
          $match: {
            status: 'OPEN',
            userId: { $ne: userId },
            $or: [
              { title: { $regex: keyword, $options: 'i' } },
              { description: { $regex: keyword, $options: 'i' } },
              { service: { $regex: keyword, $options: 'i' } },
              { profession: { $regex: keyword, $options: 'i' } },
            ],
          },
        },
        { $count: 'total' },
      ],
    });

    const countResult = Array.isArray(aggregationResult) ? 
      aggregationResult as CountAggregationResult[] : 
      [aggregationResult] as CountAggregationResult[];
    return countResult[0]?.total || 0;
  }

  /**
   * Build paginated response
   */
  private buildPaginatedResponse(errands: ErrandWithGeoData[], total: number, page: number, limit: number): PaginatedErrands {
    const totalPages = Math.ceil(total / limit);

    return {
      data: errands as Errand[],
      total,
      page,
      limit,
      totalPages,
      hasNextPage: page < totalPages,
      hasPreviousPage: page > 1,
    };
  }
}
