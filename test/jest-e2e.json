{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@module/(.*)$": "<rootDir>/src/modules/$1",
    "^@module$": "<rootDir>/src/modules",
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@src$": "<rootDir>/src"
  }
}
