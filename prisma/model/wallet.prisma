model Wallet {
  id String @id @map("_id")
  userId String
  currency String?
  createdAt DateTime
  updatedAt DateTime

  @@unique([userId]) // backs: WalletAlreadyExistsError
}

model LedgerEntry {
  id String @id @map("_id")
  walletId String
  userId String
  type LedgerEntryType
  amountMinorUnits Int
  currency String
  escrowId String?
  gatewayReference String?
  idempotencyKey String
  sequence Int
  metadata Json?
  createdAt DateTime

  @@index([walletId, createdAt]) // serves: findByWalletId
  @@index([escrowId]) // serves: findByEscrowId
  @@index([gatewayReference]) // serves: findByGatewayReference
  @@unique([idempotencyKey]) // backs: DuplicateLedgerEntryError
}

model WalletBalanceSnapshot {
  id                  String @id @map("_id")
  walletId            String @unique
  activeErrandBalance Int
  pendingBalance      Int
  availableBalance    Int
  lastSequence        Int      // monotonic counter, not a timestamp — see Gap 2 fix below
  updatedAt           DateTime @updatedAt
}

enum LedgerEntryType {
  ACTIVE_ERRAND_CREDIT
  ACTIVE_ERRAND_REVERSAL
  PENDING_CREDIT
  PENDING_REVERSAL
  AVAILABLE_CREDIT
  WITHDRAWAL_DEBIT
  REFUND_CREDIT
}

model WalletLedgerSequence {
  id String @id @map("_id")
  walletId String @unique
  sequence Int
}