model Wallet {
  id        String   @id @map("_id")
  userId    String   @unique
  partyId   String?  @unique
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model LedgerEntry {
  id               String          @id @map("_id")
  walletId         String
  partyId          String?
  userId           String
  type             LedgerEntryType
  amountMinorUnits Int
  currency         String
  escrowId         String?
  gatewayReference String?
  idempotencyKey   String
  sequence         Int             // monotonic per wallet — see WalletLedgerSequence
  metadata         Json?
  createdAt        DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([escrowId])
  @@index([gatewayReference])
  @@unique([idempotencyKey])
  @@map("ledger_entries")
}

model WalletBalanceSnapshot {
  id                  String   @id @map("_id")
  walletId            String   @unique
  activeErrandBalance Int      @default(0)
  pendingBalance      Int      @default(0)
  availableBalance    Int      @default(0)
  lastSequence        Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("wallet_balance_snapshots")
}

model WalletLedgerSequence {
  id       String @id @map("_id")
  walletId String @unique
  sequence Int    @default(0)

  @@map("wallet_ledger_sequences")
}

model BankAccount {
  id            String   @id @default(uuid()) @map("_id")
  ownerId       String   // PartyId / UserId
  currency      String
  bankCode      String
  accountNumber String
  accountName   String?
  isVerified    Boolean  @default(false)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@map("bank_accounts")
}

enum LedgerEntryType {
  ACTIVE_ERRAND_CREDIT
  ACTIVE_ERRAND_REVERSAL
  PENDING_CREDIT
  PENDING_REVERSAL
  AVAILABLE_CREDIT
  WITHDRAWAL_DEBIT
  REFUND_CREDIT
  COMPENSATION_CREDIT
  MANUAL_ADJUSTMENT
}