model Wallet {
    id        String    @id @default(uuid()) @map("_id")
    ownerId   String   
    ownerType UserRole // CLIENT | PROVIDER
    // Stored in minor units (kobo) to avoid Float/Decimal issues on Mongo connector
    available Int      @default(0) // Can withdraw (kobo)
    held      Int      @default(0) // Pending release (kobo)
    currency  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([ownerId, ownerType])
    @@map("wallets")
}

model Transaction {
    id        String    @id @default(uuid()) @map("_id")
    ownerId   String   
    ownerType UserRole
    errandId  String?  
    // Stored in minor units (kobo)
    amount    Int
    type      TxType
    status    TxStatus
    reference String   @unique
    metadata  Json? // e.g. { jobId: "...", workerId: "...", fee: 20 }
    createdAt DateTime @default(now())

    @@index([ownerId, ownerType])
    @@index([errandId])
    @@map("transactions")
}

enum TxType {
    FUND
    ESCROW_HOLD
    ESCROW_PENDING_CREDIT
    ESCROW_RELEASE
    WITHDRAWAL
}

enum TxStatus {
    PENDING
    SUCCESS
    FAILED
}
