enum ServiceCategoryType {
  CASUAL
  PROFESSIONAL
  ARTISAN
}

model ServiceCategory {
  id       String               @id @default(uuid()) @map("_id")
  name     String              @unique
  type     ServiceCategoryType

  @@map("service_categories")
}

model Service {
  id         String               @id @default(uuid()) @map("_id")
  name       String              @unique
  type       ServiceCategoryType
  categoryId String

  @@map("services")
}

model ServicesOnProviders {
  id        String  @id @default(uuid()) @map("_id")
  serviceId String 
  providerId  String

  @@unique([providerId, serviceId])
  @@map("services_on_providers")
}
