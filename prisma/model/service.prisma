model Service {
  id                    String   @id @default(uuid()) @map("_id")
  listedById            String
  categoryId            String
  marketId              String
  title                 String
  description           String
  priceAmountMinorUnits Int
  priceCurrency         String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("services")
}

model ServicesOnProviders {
  id              String @id @default(uuid()) @map("_id")
  serviceId       String
  providerPartyId String

  @@unique([providerPartyId, serviceId])
  @@map("services_on_providers")
}
