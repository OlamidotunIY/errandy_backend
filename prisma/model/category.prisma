model Category {
    id               String     @id @default(uuid()) @map("_id")
    name             String     @unique
    parentCategoryId String?
    parent           Category?  @relation("CategoryChildren", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    children         Category[] @relation("CategoryChildren")
    requiredTier     String? // ProviderTier — only set on leaf categories (no children); parents are browsing-only groupings
}
