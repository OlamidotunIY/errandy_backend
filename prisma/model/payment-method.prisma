model PaymentMethod {
    id      String @id @default(uuid()) @map("_id")
    partyId String // Party.id — gated to a ClientRole

    provider    String // "paystack", "stripe", "paypal", "adyen"
    providerRef String // e.g. Paystack authorization_code, Stripe paymentMethodId
    type        String // "card", "bank_account", "wallet", "paypal"

    cardBrand String? // Visa, Mastercard, Amex
    last4     String? // Last 4 digits for display
    expMonth  Int?
    expYear   Int?

    isDefault Boolean @default(false)
    verified  Boolean @default(false)
    isActive  Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payment_methods")
}

model PaystackCustomer {
    id            String @id @default(uuid()) @map("_id")
    customer_code String
    customer_id   String

    userId String

    @@unique([userId])
    @@map("paystack_customers")
}
