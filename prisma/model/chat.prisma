model ChatThread {
    id              String    @id @default(uuid()) @map("_id")
    errandId        String
    participantIds  String[]
    createdAt       DateTime  @default(now())
    closedAt        DateTime?
    firstResponseAt DateTime?

    @@unique([errandId])
    @@map("chat_threads")
}

model ChatMessage {
    id       String   @id @default(uuid()) @map("_id")
    threadId String
    senderId String
    content  String
    sentAt   DateTime @default(now())

    @@index([threadId, sentAt])
    @@map("chat_messages")
}
