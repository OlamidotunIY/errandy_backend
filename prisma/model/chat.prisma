model ChatRoom {
    id             String    @id @default(uuid()) @map("_id")
    participantIds String[] // array of user IDs
    roomKey        String?  @unique

    unreadCount Int @default(0)

    lastMessageId String?  @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("rooms")
}

model Message {
    id       String  @id @default(uuid()) @map("_id")
    roomId   String 
    senderId String

    content    String?
    contentUrl String? // used for voice, images, files
    type       MessageType @default(TEXT)

    fileName   String?
    fileSize   Int?
    mimeType   String?
    width      Int?
    height     Int?
    durationMs Int?
    waveform   Json?

    seen      Boolean @default(false)
    delivered Boolean @default(false)
    sent      Boolean @default(false)

    createdAt DateTime @default(now())

    @@map("messages")
}

model Reaction {
    id        String   @id @default(uuid()) @map("_id")
    messageId String  
    userId    String
    emoji     String // e.g. "👍", "❤️", etc.

    @@map("reactions")
}

enum MessageType {
    TEXT
    IMAGE
    VIDEO
    FILE
    VOICE
}
