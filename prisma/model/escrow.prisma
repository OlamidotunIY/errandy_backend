model Escrow {
    id              String       @id @default(uuid()) @map("_id")
    errandId        String      @unique
    clientId        String
    workerId        String
    // Stored in minor units (kobo)
    amountGross     Int
    platformFee     Int
    amountNetWorker Int
    currency        String
    status          EscrowStatus
    holdUntil       DateTime?
    releasedAt      DateTime?
    refundedAt      DateTime?
    completedAt     DateTime?
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt

    @@index([clientId])
    @@index([workerId])
    @@index([status])
    @@map("escrows")
}

enum EscrowStatus {
     PENDING
     FUNDED
     COMPLETED_PENDING_PAYOUT
     RELEASING
     RELEASED
     REFUNDING
     REFUNDED
     DISPUTED
}
