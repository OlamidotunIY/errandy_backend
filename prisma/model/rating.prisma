enum RateeType {
    PROVIDER
    CLIENT
}

model Rating {
    id        String     @id @default(uuid()) @map("_id")
    raterId   String    
    rateeId   String    
    rateeType RateeType
    errandId  String?   
    rating    Int
    comment   String?
    createdAt DateTime  @default(now())

    @@map("ratings")
}

model RatingReaction {
    id        String    @id @default(uuid()) @map("_id")
    ratingId  String   
    userId    String   
    emoji     String // e.g. "👍", "❤️", "😊"
    createdAt DateTime @default(now())


    @@unique([ratingId, userId])
    @@map("rating_reactions")
}

model RatingReply {
    id        String    @id @default(uuid()) @map("_id")
    ratingId  String   
    userId    String   
    content   String
    createdAt DateTime @default(now())

    @@map("rating_replies")
}
