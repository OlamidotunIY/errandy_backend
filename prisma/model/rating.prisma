enum RateeType {
    PROVIDER
    CLIENT
}

model Rating {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    raterId   String    @db.ObjectId
    rateeId   String    @db.ObjectId
    rateeType RateeType
    errandId  String?   @db.ObjectId
    rating    Int
    comment   String?
    createdAt DateTime  @default(now())

    // Relations
    errand    Errand?          @relation(fields: [errandId], references: [id])
    client    Client?          @relation(fields: [rateeId], references: [id])
    provider  Provider?        @relation(fields: [rateeId], references: [id])
    reactions RatingReaction[]
    replies   RatingReply[]

    @@map("ratings")
}

model RatingReaction {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    ratingId  String   @db.ObjectId
    userId    String   @db.ObjectId
    emoji     String // e.g. "👍", "❤️", "😊"
    createdAt DateTime @default(now())

    rating Rating @relation(fields: [ratingId], references: [id])

    @@unique([ratingId, userId])
    @@map("rating_reactions")
}

model RatingReply {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    ratingId  String   @db.ObjectId
    userId    String   @db.ObjectId
    content   String
    createdAt DateTime @default(now())

    rating Rating @relation(fields: [ratingId], references: [id])

    @@map("rating_replies")
}
