model Application {
    id       String @id @default(auto()) @map("_id") @db.ObjectId
    errandId String @db.ObjectId
    workerId String @db.ObjectId

    status     AppStatus @default(PENDING)
    acceptedAt DateTime?

    source ApplicationSource @default(PUBLIC)

    createdAt DateTime @default(now())

    @@unique([errandId, workerId])
    @@map("applications")
}

enum AppStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELLED
}

enum ApplicationSource {
    PUBLIC
    INVITED
}
