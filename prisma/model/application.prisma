model Application {
    id       String  @id @default(uuid()) @map("_id")
    errandId String
    workerId String 

    status     AppStatus @default(PENDING)
    acceptedAt DateTime?

    source ApplicationSource @default(PUBLIC)

    createdAt DateTime @default(now())

    @@unique([errandId, workerId])
    @@map("applications")
}

enum AppStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELLED
}

enum ApplicationSource {
    PUBLIC
    INVITED
}
