model Application {
    id       String  @id @default(uuid()) @map("_id")
    errandId String
    providerPartyId String
    applicantType ApplicationType

    status     AppStatus @default(PENDING)
    proposal String?
    proposedAmountMinorUnits Int?
    currency String?
    acceptedAt DateTime?

    rejectedAt DateTime?
    cancelledAt DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([errandId, providerPartyId])
    @@index([errandId, status])
    @@index([providerPartyId, status])
    @@map("applications")
}

enum AppStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELLED
}

enum ApplicationType {
    PROVIDER
    ORGANIZATION
}
