model Application {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    errandId  String    @db.ObjectId
    workerId  String    @db.ObjectId
    status    AppStatus // ENUM: "PENDING", "ACCEPTED", "REJECTED", "CANCELLED"
    createdAt DateTime  @default(now())

    @@map("applications")
}

enum AppStatus {
    PENDING
    ACCEPTED
    REJECTED
    CANCELLED
}
