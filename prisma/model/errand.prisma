model Errand {
    id                     String       @id @default(uuid()) @map("_id")
    clientPartyId          String        
    title                  String
    description            String?
    pricingType            PricingType   @default(FIXED)
    price                  Float?
    hourlyRate             Float?
    transportAllowance     Float?
    materialsBudget        Float?
    status                 ErrandStatus? @default(DRAFT)
    providerType           ProviderType?
    serviceId              String?       
    assignedTo             String?       
    assignedAt             DateTime?
    completionDurationDays Int? // e.g. 10
    completionDeadline     DateTime? // computed AFTER assignment

    // Source type to distinguish job types
    sourceType     ErrandSourceType @default(CLIENT_JOB)

    // Snapshot of provider org (for listings)
    organizationPartyId  String?          

    serviceAddress String?
    location       Json?
    templateId     String?  
    isRecurring    Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@map("errands")
}

model SavedErrand {
    id       String    @id @default(uuid()) @map("_id")
    userId   String
    errandId String
    savedAt  DateTime @default(now())

    @@map("saved_errands")
}

model ErrandBundle {
    id          String   @id @default(uuid()) @map("_id")
    name        String
    description String
    basePrice   Float
    active      Boolean @default(true)

    @@map("errand_bundles")
}

model BundleItem {
    id         String  @id @default(uuid()) @map("_id")
    bundleId   String 
    templateId String

    @@map("bundle_items")
}

model ErrandTemplate {
    id String  @id @default(uuid()) @map("_id")

    title       String
    description String?
    pricingType PricingType
    price       Float?
    hourlyRate  Float?

    serviceId    String?       
    providerType ProviderType?

    serviceAddress String?
    location       Json?

    // Listing ownership
    organizationPartyId String? 

    // Listing state
    publishState ListingPublishState @default(DRAFT)
    publishedAt  DateTime?

    // Listing metadata
    isListing   Boolean  @default(false)
    listingTags String[]

    createdAt DateTime @default(now())

    @@map("errand_templates")
}

model ErrandAssignment {
  id       String  @id @default(uuid()) @map("_id")
  errandId String 

  // who is responsible at org level
  organizationPartyId  String 

  // optional: specific members assigned
  providerPartyId String? 

  role AssignmentRole @default(MEMBER)
  status AssignmentStatus @default(ASSIGNED)

  assignedAt DateTime @default(now())

  @@index([errandId])
  @@map("errand_assignments")
}

model RecurringContract {
  id String  @id @default(uuid()) @map("_id")

  clientPartyId      String 
  organizationPartyId String 
  templateId    String 

  frequency RecurrenceFrequency
  nextRunAt DateTime
  active    Boolean @default(true)

  // Pre-acceptance flag
  providerPreAccepted Boolean @default(false)
  acceptedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_contracts")
}

enum AssignmentRole {
  LEAD
  MEMBER
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  REMOVED
}


enum ErrandSourceType {
    CLIENT_JOB         // Traditional client-posted job
    LISTING_HIRE       // One-off hire from provider listing
    RECURRING_CONTRACT // Recurring contract from listing
}

enum ListingPublishState {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum RecurrenceFrequency {
    WEEKLY
    MONTHLY
}

enum ErrandStatus {
    DRAFT
    OPEN
    IN_PROGRESS
    COMPLETED
    CANCELLED
    OVERDUE
}

enum ProviderType {
    PROFESSIONAL
    GENERAL
    ARTISAN
}

enum PricingType {
    FIXED
    HOURLY
}
