model Errand {
    id                     String        @id @default(auto()) @map("_id") @db.ObjectId
    clientId               String        @db.ObjectId
    title                  String
    description            String?
    pricingType            PricingType   @default(FIXED)
    price                  Float?
    hourlyRate             Float?
    transportAllowance     Float?
    materialsBudget        Float?
    status                 ErrandStatus? @default(DRAFT)
    providerType           ProviderType?
    serviceId              String?       @db.ObjectId
    assignedTo             String?       @db.ObjectId
    assignedAt             DateTime?
    completionDurationDays Int? // e.g. 10
    completionDeadline     DateTime? // computed AFTER assignment

    serviceAddress String?
    location       Json?
    templateId     String?  @db.ObjectId
    isRecurring    Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ratings        Rating[]

    client       Client          @relation(fields: [clientId], references: [id])
    savedErrands SavedErrand[]
    service      Service?        @relation(fields: [serviceId], references: [id])
    template     ErrandTemplate? @relation(fields: [templateId], references: [id])

    @@map("errands")
}

model SavedErrand {
    id       String   @id @default(auto()) @map("_id") @db.ObjectId
    userId   String
    errandId String   @db.ObjectId
    savedAt  DateTime @default(now())

    // Relation
    errand Errand @relation(fields: [errandId], references: [id])

    @@map("saved_errands")
}

model RecurringErrand {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    clientId   String @db.ObjectId
    templateId String @db.ObjectId

    frequency RecurrenceFrequency
    nextRunAt DateTime
    active    Boolean             @default(true)

    client   Client         @relation(fields: [clientId], references: [id])
    template ErrandTemplate @relation(fields: [templateId], references: [id])

    @@map("recurring_errands")
}

model ErrandBundle {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String
    basePrice   Float
    active      Boolean @default(true)

    items BundleItem[]

    @@map("errand_bundles")
}

model BundleItem {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    bundleId   String @db.ObjectId
    templateId String @db.ObjectId

    bundle   ErrandBundle   @relation(fields: [bundleId], references: [id])
    template ErrandTemplate @relation(fields: [templateId], references: [id])

    @@map("bundle_items")
}

model ErrandTemplate {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title       String
    description String?
    pricingType PricingType
    price       Float?
    hourlyRate  Float?

    serviceId    String?       @db.ObjectId
    providerType ProviderType?

    serviceAddress String?
    location       Json?

    createdAt DateTime @default(now())

    recurringErrands RecurringErrand[]
    errands          Errand[]
    bundleItems      BundleItem[]

    @@map("errand_templates")
}

enum RecurrenceFrequency {
    WEEKLY
    MONTHLY
}

enum ErrandStatus {
    DRAFT
    OPEN
    IN_PROGRESS
    COMPLETED
    CANCELLED
    OVERDUE
}

enum ProviderType {
    PROFESSIONAL
    GENERAL
    ARTISAN
}

enum PricingType {
    FIXED
    HOURLY
}
