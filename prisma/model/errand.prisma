model Errand {
    id                  String        @id @default(auto()) @map("_id") @db.ObjectId
    clientId            String        @db.ObjectId
    title               String
    description         String?
    pricingType         PricingType   @default(FIXED)
    price               Float?
    hourlyRate          Float?
    status              ErrandStatus? @default(DRAFT)
    workerType          WorkerType?
    serviceId           String?       @db.ObjectId
    assignedTo          String?       @db.ObjectId
    applicationDeadline DateTime?
    completionDeadline  DateTime?
    serviceAddress      String? // e.g., "12 Palm Street, Lagos"
    location            Json?
    createdAt           DateTime      @default(now())
    updatedAt           DateTime      @updatedAt
    ratings             Rating[]

    client       Client        @relation(fields: [clientId], references: [id])
    savedErrands SavedErrand[]
    service      Service?       @relation(fields: [serviceId], references: [id])

    @@map("errands")
}

model SavedErrand {
    id       String   @id @default(auto()) @map("_id") @db.ObjectId
    userId   String
    errandId String   @db.ObjectId
    savedAt  DateTime @default(now())

    // Relation
    errand Errand @relation(fields: [errandId], references: [id])

    @@map("saved_errands")
}

enum ErrandStatus {
    DRAFT
    OPEN
    IN_PROGRESS
    COMPLETED
    CANCELLED
    OVERDUE
}

enum WorkerType {
    PROFESSIONAL
    GENERAL
    ARTISAN
}

enum PricingType {
    FIXED
    HOURLY
}
