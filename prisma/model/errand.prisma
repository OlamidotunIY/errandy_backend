model Errand {
  id                           String    @id @default(uuid()) @map("_id")
  clientId                     String    // Party — plain scalar
  serviceId                    String?   
  categoryId                   String    
  title                        String
  description                  String
  addressId                    String    
  location                     Json      // denormalized GeoJSON Point: { type: "Point", coordinates: [lng, lat] }
  state                        String    // state boundary filter
  budget                       Money
  status                       String    @default("DRAFT") // DRAFT | PUBLISHED | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED | ARCHIVED
  sourceType                   String    @default("OPEN_BID") // OPEN_BID | TRUSTED_DIRECT_ASSIGN | SERVICE_BOOKING
  requiredTier                 String    @default("COMMUNITY") // COMMUNITY | VERIFIED | CERTIFIED
  marketId                     String    
  acceptedApplicationId        String?   
  workerPoolPercentageOverride Int?
  expectedStartAt              DateTime? // set at assignment time; drives NoShowDetectionJob
  startedAt                    DateTime?
  completedAt                  DateTime?
  completedBy                  String?   // CLIENT | SYSTEM
  cancelledAt                  DateTime?
  cancellationReason           String?   // CLIENT_CANCELLED | WORKER_CANCELLED | WORKER_NO_SHOW | SYSTEM_CANCELLED
  relistedFromErrandId         String?   
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([marketId, status, categoryId])
  @@index([marketId, state, status])
  @@index([status, expectedStartAt])
  @@map("errands")
}

model ErrandAssignment {
  id                       String    @id @default(uuid()) @map("_id")
  errandId                 String    
  profileId                String    // the individual Party doing the work — plain scalar
  assignedByOrganizationId String?   
  splitPercentage          Int?
  status                   String    @default("ASSIGNED") // ASSIGNED | CONFIRMED_DONE | CANCELLED | REMOVED
  confirmedAt              DateTime?
  proofUrl                 String?
  assignedAt               DateTime  @default(now())

  @@index([errandId])
  @@map("errand_assignments")
}
