model Errand {
    id                     String        @id @default(auto()) @map("_id") @db.ObjectId
    clientId               String        @db.ObjectId
    title                  String
    description            String?
    pricingType            PricingType   @default(FIXED)
    price                  Float?
    hourlyRate             Float?
    transportAllowance     Float?
    materialsBudget        Float?
    status                 ErrandStatus? @default(DRAFT)
    providerType           ProviderType?
    serviceId              String?       @db.ObjectId
    assignedTo             String?       @db.ObjectId
    assignedAt             DateTime?
    completionDurationDays Int? // e.g. 10
    completionDeadline     DateTime? // computed AFTER assignment

    // Source type to distinguish job types
    sourceType     ErrandSourceType @default(CLIENT_JOB)

    // Snapshot of provider org (for listings)
    providerOrgId  String?          @db.ObjectId

    serviceAddress String?
    location       Json?
    templateId     String?  @db.ObjectId
    isRecurring    Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ratings        Rating[]

    client       Client          @relation(fields: [clientId], references: [id])
    savedErrands SavedErrand[]
    service      Service?        @relation(fields: [serviceId], references: [id])
    template     ErrandTemplate? @relation(fields: [templateId], references: [id])
    escrow       Escrow?
    assignments  ErrandAssignment[]

    @@map("errands")
}

model SavedErrand {
    id       String   @id @default(auto()) @map("_id") @db.ObjectId
    userId   String
    errandId String   @db.ObjectId
    savedAt  DateTime @default(now())

    // Relation
    errand Errand @relation(fields: [errandId], references: [id])

    @@map("saved_errands")
}

model ErrandBundle {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String
    basePrice   Float
    active      Boolean @default(true)

    items BundleItem[]

    @@map("errand_bundles")
}

model BundleItem {
    id         String @id @default(auto()) @map("_id") @db.ObjectId
    bundleId   String @db.ObjectId
    templateId String @db.ObjectId

    bundle   ErrandBundle   @relation(fields: [bundleId], references: [id])
    template ErrandTemplate @relation(fields: [templateId], references: [id])

    @@map("bundle_items")
}

model ErrandTemplate {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    title       String
    description String?
    pricingType PricingType
    price       Float?
    hourlyRate  Float?

    serviceId    String?       @db.ObjectId
    providerType ProviderType?

    serviceAddress String?
    location       Json?

    // Listing ownership
    providerOrgId String? @db.ObjectId

    // Listing state
    publishState ListingPublishState @default(DRAFT)
    publishedAt  DateTime?

    // Listing metadata
    isListing   Boolean  @default(false)
    listingTags String[]

    createdAt DateTime @default(now())

    providerOrg        Organization?     @relation(fields: [providerOrgId], references: [id])
    service            Service?          @relation(fields: [serviceId], references: [id])
    errands            Errand[]
    bundleItems        BundleItem[]
    recurringContracts RecurringContract[]

    @@map("errand_templates")
}

model ErrandAssignment {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  errandId String @db.ObjectId

  // who is responsible at org level
  providerOrgId  String @db.ObjectId

  // optional: specific members assigned
  workerId String? @db.ObjectId

  role AssignmentRole @default(MEMBER)
  status AssignmentStatus @default(ASSIGNED)

  assignedAt DateTime @default(now())

  errand Errand @relation(fields: [errandId], references: [id])

  @@index([errandId])
  @@map("errand_assignments")
}

model RecurringContract {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clientId      String @db.ObjectId
  providerOrgId String @db.ObjectId
  templateId    String @db.ObjectId

  frequency RecurrenceFrequency
  nextRunAt DateTime
  active    Boolean @default(true)

  // Pre-acceptance flag
  providerPreAccepted Boolean @default(false)
  acceptedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client   Client         @relation(fields: [clientId], references: [id])
  template ErrandTemplate @relation(fields: [templateId], references: [id])

  @@map("recurring_contracts")
}

enum AssignmentRole {
  LEAD
  MEMBER
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  REMOVED
}


enum ErrandSourceType {
    CLIENT_JOB         // Traditional client-posted job
    LISTING_HIRE       // One-off hire from provider listing
    RECURRING_CONTRACT // Recurring contract from listing
}

enum ListingPublishState {
    DRAFT
    PUBLISHED
    ARCHIVED
}

enum RecurrenceFrequency {
    WEEKLY
    MONTHLY
}

enum ErrandStatus {
    DRAFT
    OPEN
    IN_PROGRESS
    COMPLETED
    CANCELLED
    OVERDUE
}

enum ProviderType {
    PROFESSIONAL
    GENERAL
    ARTISAN
}

enum PricingType {
    FIXED
    HOURLY
}
