model Dispute {
  id              String  @id @default(uuid()) @map("_id")
  errandId        String
  clientPartyId   String
  providerPartyId String
  status          DisputeStatus
  reason          String
  createdAt       DateTime @default(now())

  @@map("disputes")
}

enum DisputeStatus {
  PENDING
  ACCEPTED
  REJECTED
}
