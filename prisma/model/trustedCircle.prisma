model TrustedCircle {
  id            String    @id @default(uuid()) @map("_id")
  clientPartyId String   
  name          String? // e.g. "Family Helpers"
  createdAt     DateTime @default(now())

  @@map("trusted_circles")
}

model TrustedCircleMember {
  id              String        @id @default(uuid()) @map("_id")
  trustedCircleId String       
  providerPartyId String       
  addedAt         DateTime     @default(now())
  source          CircleSource @default(COMPLETED_TASK)

  status TrustedCircleMemberStatus @default(ACTIVE)

  @@unique([trustedCircleId, providerPartyId])
  @@map("trusted_circle_members")
}

enum TrustedCircleMemberStatus {
  ACTIVE
  PENDING
}

enum CircleSource {
  COMPLETED_TASK
  MANUAL_ADD
  INVITED
}
